# DUSPOR FLOW — variáveis de ambiente
# Copie este arquivo para .env e preencha se for usar os recursos abaixo.
# NUNCA coloque chaves reais neste arquivo .env.example nem no código.

# Porta do servidor (opcional, default 3000)
PORT=3000

# Opcional: se configurada, o Assistente de IA (módulo 11) e a Validação
# inteligente (módulo 3) PODERIAM futuramente chamar um modelo de linguagem
# real (ex: Anthropic Claude) para análises mais ricas, em vez do motor de
# regras determinístico usado hoje no MVP. Sem esta chave, o sistema funciona
# normalmente em "modo de regras" — isso é sinalizado na interface.
ANTHROPIC_API_KEY=
